---
import NewsLayout from "../../layouts/NewsLayout.astro";
import {
  formatPublishedAt,
  getCategoryLabel,
  getNewsList,
  stripHtml,
  type News,
} from "../../lib/microcms";

export async function getStaticPaths() {
  const { contents } = await getNewsList({ limit: 100, orders: "-publishedAt" });
  return contents.map((news) => ({
    params: { slug: news.id },
    props: { news },
  }));
}

interface Props {
  news: News;
}

const { news } = Astro.props;
const dateIso = news.publishedAt ?? news.createdAt;
const dateLabel = formatPublishedAt(dateIso);
const category = getCategoryLabel(news.category);
const description = stripHtml(news.content, 120) || `FlowReport からのお知らせ: ${news.title}`;
---

<NewsLayout
  title={`${news.title} — FlowReport お知らせ`}
  description={description}
  heading={news.title}
  eyebrow={category ?? "News"}
  ogType="article"
>
  <div class="-mt-6 mb-2 flex flex-wrap items-center gap-3 text-xs text-ink-500">
    {dateLabel && <time datetime={dateIso} class="tabular-nums">{dateLabel}</time>}
    {category && (
      <span class="rounded-full border border-brand-200 bg-brand-50 px-2.5 py-0.5 text-[11px] font-medium text-brand-700">
        {category}
      </span>
    )}
  </div>

  <article class="news-prose mt-6" set:html={news.content} />

  <div class="mt-12 border-t border-ink-200 pt-6">
    <a href="/news" class="text-sm text-ink-600 transition hover:text-ink-900">
      ← お知らせ一覧に戻る
    </a>
  </div>
</NewsLayout>
