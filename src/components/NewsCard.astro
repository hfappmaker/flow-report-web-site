---
import { formatPublishedAt, getCategoryLabel, stripHtml, type News } from "../lib/microcms";

interface Props {
  news: News;
}

const { news } = Astro.props;
const dateIso = news.publishedAt ?? news.createdAt;
const dateLabel = formatPublishedAt(dateIso);
const category = getCategoryLabel(news.category);
const excerpt = stripHtml(news.content, 90);
---

<a href={`/news/${news.id}`} class="card group block">
  <div class="flex flex-wrap items-center gap-3 text-xs text-ink-500">
    {dateLabel && (
      <time datetime={dateIso} class="tabular-nums">{dateLabel}</time>
    )}
    {category && (
      <span class="rounded-full border border-brand-200 bg-brand-50 px-2.5 py-0.5 text-[11px] font-medium text-brand-700">
        {category}
      </span>
    )}
  </div>
  <h3 class="mt-3 text-base font-semibold tracking-tight text-ink-900 transition group-hover:text-brand-600">
    {news.title}
  </h3>
  {excerpt && (
    <p class="mt-2 line-clamp-2 text-sm leading-relaxed text-ink-600">{excerpt}</p>
  )}
  <span class="mt-4 inline-flex items-center gap-1 text-xs font-medium text-brand-600">
    詳しく見る
    <svg viewBox="0 0 24 24" width="12" height="12" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" class="transition group-hover:translate-x-0.5">
      <path d="M5 12h14M13 6l6 6-6 6"/>
    </svg>
  </span>
</a>
